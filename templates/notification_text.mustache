{{!
    @template local_mail/notification_text

    Text notification template.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * coursename
    * sendername
    * date
    * subject
    * content
    * hasattachments
    * attachments: array of objects with path, size and url
    * viewurl

    Example context (json):
    {
        "coursename": "Introduction to algebra",
        "sendername": "Alice Wonder",
        "date": "1 January 2026, 10:00",
        "subject": "Assignment feedback",
        "content": "Please read the attached notes before the next session.",
        "hasattachments": true,
        "attachments": [
            {
                "path": "notes.pdf",
                "size": "12.4 KB",
                "url": "https://example.com/pluginfile.php/1/local_mail/message/1/notes.pdf"
            }
        ],
        "viewurl": "https://example.com/local/mail/view.php?t=inbox&m=1"
    }
}}
{{#str}} from, local_mail {{/str}}: {{{ sendername }}}
{{#str}} subject, local_mail {{/str}}:  {{{ subject }}}
{{#str}} course, local_mail {{/str}}: {{{ coursename }}}
{{#str}} date, local_mail {{/str}}: {{{ date }}}

{{{ content }}}
{{# hasattachments }}

{{# attachments }}
{{{ path }}} ({{{ size }}}): {{{ url }}}
{{/ attachments }}
{{/ hasattachments }}

---------
{{#str}} viewmessage, local_mail {{/str}}: {{{ viewurl }}}
